<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PostScript tokenizer, expression compiler and evaluator for .NET. A standalone managed implementation with no rendering dependencies, used by PdfPixel for Type 4 (PostScript calculator) functions and Type 1 font programs.</Description>
    <PackageTags>postscript;interpreter;tokenizer;evaluator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PdfPixel.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>

</Project>
