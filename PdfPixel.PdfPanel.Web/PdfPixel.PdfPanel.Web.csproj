<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- <RunAOTCompilationAfterBuild>true</RunAOTCompilationAfterBuild> -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPixel.PdfPanel\PdfPixel.PdfPanel.csproj" />
    <!--
      PdfPixel references these with PrivateAssets="all" so they aren't listed as NuGet
      dependencies of the published PdfPixel package. That also stops them from flowing
      transitively in the restore graph, which the Blazor WASM publish/AOT pipeline relies
      on to pick assemblies for the wasm output. Referenced directly here so they're included.
      TODO: [LOW] remove when all packages will be published as separate NuGet packages
    -->
    <ProjectReference Include="..\PdfPixel.Color\PdfPixel.Color.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PdfPixel.Jpg\PdfPixel.Jpg.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PdfPixel.Jpx\PdfPixel.Jpx.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PdfPixel.Ccitt\PdfPixel.Ccitt.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PdfPixel.Jbig2\PdfPixel.Jbig2.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PdfPixel.PostScript\PdfPixel.PostScript.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <NativeFileReference Include="Native/libEGL.c" ScanForPInvokes="true" />
    <NativeFileReference Include="Native/openal32.c" ScanForPInvokes="true" />
    <NativeFileReference Include="Native/emscripten.c" ScanForPInvokes="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.148.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.10" />

  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

