<Window x:Class="PdfPixel.Demo.Wpf.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Required"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ThemeMode="Light"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="This document is password protected. Enter the password to open it." TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorTextBlock" Foreground="Red" Margin="0 8 0 0" TextWrapping="Wrap" Visibility="Collapsed" />
        <PasswordBox x:Name="PasswordBox" Margin="0 12 0 0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button Content="Cancel" Width="80" IsCancel="True" Margin="0 0 8 0" />
            <Button Content="OK" Width="80" IsDefault="True" Click="OkButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
