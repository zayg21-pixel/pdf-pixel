<Window x:Class="PdfPixel.Demo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdfPixel.Demo.Wpf"
        xmlns:pdfPanel="clr-namespace:PdfPixel.PdfPanel;assembly=PdfPixel.PdfPanel"
        xmlns:pdfPanelAnnotations="clr-namespace:PdfPixel.PdfPanel.Annotations;assembly=PdfPixel.PdfPanel"
        xmlns:pdfPanelMvvm="clr-namespace:PdfPixel.PdfPanel.Mvvm;assembly=PdfPixel.PdfPanel"
        xmlns:wpfPdfPanel="clr-namespace:PdfPixel.PdfPanel.Wpf;assembly=PdfPixel.PdfPanel.Wpf"
        mc:Ignorable="d"
        Icon="logo.ico"
        ThemeMode="Light"
        Title="PDF Pixel" Width="800" Height="600">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:SearchStatusConverter x:Key="SearchStatusConverter" />
        <Style x:Key="PageTextBoxStyle" TargetType="{x:Type local:PageTextBox}">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:PageTextBox}">
                        <Border x:Name="border"
                                CornerRadius="1"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="0"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Margin" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <local:MainWindowsViewModel />
    </Window.DataContext>

    <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition  />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding PdfFiles}"
                      DisplayMemberPath="FileName"
                      SelectedItem="{Binding SelectedPdfFile}"
                      Visibility="{Binding HasFiles, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ToolBar Grid.Column="1" HorizontalAlignment="Center" ToolBarTray.IsLocked="True" Margin="8 0">
                <Button Command="{Binding OpenFileCommand}" ToolTip="Zoom In" Cursor="Hand">
                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" VerticalAlignment="Center" />
                </Button>

                <Button Command="{Binding ZoomInCommand}" ToolTip="Zoom In" Cursor="Hand">
                    <TextBlock Text="&#xE8A3;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" VerticalAlignment="Center" />
                </Button>

                <Button Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out" Cursor="Hand">
                    <TextBlock Text="&#xE71F;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" VerticalAlignment="Center" />
                </Button>

                <Separator VerticalAlignment="Center" Height="20" Margin="4 0" />

                <TextBlock Text="{Binding PageLabel, ElementName=pdfPanel}" VerticalAlignment="Center" Margin="4 0" />

                <local:PageTextBox
                    Style="{StaticResource PageTextBoxStyle}"
                    Page="{Binding PageNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    MaxPage="{Binding Pages.Count}"
                    Margin="4"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinWidth="40" />
                <TextBlock Text="of" VerticalAlignment="Center" Margin="8 0" />
                <TextBlock Text="{Binding Pages.Count}" VerticalAlignment="Center" />

                <Separator VerticalAlignment="Center" Height="20" Margin="4 0" />

                <Button Command="{Binding RotateAllPagesCommand}" ToolTip="Rotate All Pages">
                    <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" />
                </Button>

                <Button Command="{Binding RotatePageCommand}" ToolTip="Rotate Current Page">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Margin="0 0 2 0" />
                        <TextBlock Text="₁" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ToggleAutoScaleCommand}" ToolTip="Change Pages Fit Mode">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutoScaleMode}" Value="ScaleToWidth">
                                        <Setter Property="Text" Value="&#xE9A6;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AutoScaleMode}" Value="ScaleToHeight">
                                        <Setter Property="Text" Value="&#xE9A6;" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90" CenterX="8" CenterY="8" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AutoScaleMode}" Value="NoAutoScale">
                                        <Setter Property="Text" Value="&#xF599;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </ToolBar>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl Margin="4 0 0 4">
                <TabItem Header="Layers">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ComboBox ItemsSource="{Binding Layers.Configurations, ElementName=pdfPanel}"
                                  SelectedItem="{Binding Layers.Configuration, ElementName=pdfPanel}"
                                  Margin="0 0 0 4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type pdfPanelMvvm:PdfLayerConfigurationViewModel}">
                                    <TextBlock Text="{Binding Name, TargetNullValue='Unnamed configuration'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TreeView Grid.Row="1" ItemsSource="{Binding Layers.Configuration.Layers, ElementName=pdfPanel}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type pdfPanelMvvm:PdfLayerViewModel}" ItemsSource="{Binding Children}">
                                    <Grid>
                                        <CheckBox Content="{Binding Name, TargetNullValue='Unnamed layer'}"
                                                  IsChecked="{Binding IsVisible}"
                                                  Visibility="{Binding IsLayer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <TextBlock Text="{Binding Name, TargetNullValue='Unnamed'}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLayer}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
                <wpfPdfPanel:WpfPdfPanel x:Name="pdfPanel"
                                         CurrentPage="{Binding PageNumber}"
                                         Pages="{Binding Pages}"
                                         AutoScaleMode="{Binding AutoScaleMode}"
                                         SearchQuery="{Binding SearchQuery}"
                                         CurrentSearchResult="{Binding CurrentSearchResult}"
                                         ExtractText="{Binding ExtractText}"
                                         SearchMatchCase="{Binding SearchMatchCase}"
                                         SearchWholeWord="{Binding SearchWholeWord}"
                                         SearchMatchDiacritics="{Binding SearchMatchDiacritics}"
                                         PanelInterface="{Binding PanelInterface}"
                                         PageCornerRadius="4">
                    <wpfPdfPanel:WpfPdfPanel.AnnotationToolTip>
                        <ToolTip>
                            <ToolTip.Resources>
                                <DataTemplate DataType="{x:Type pdfPanelAnnotations:PdfAnnotationMessage}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Margin="4" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Contents}" Margin="4" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CreationDate}" Margin="4" FontSize="10" />
                                        <ItemsControl ItemsSource="{Binding Replies}" Margin="12,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ToolTip.Resources>
                            <ToolTip.ContentTemplate>
                                <DataTemplate DataType="{x:Type pdfPanelAnnotations:PdfAnnotationPopup}">
                                    <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="360" />
                                </DataTemplate>
                            </ToolTip.ContentTemplate>
                        </ToolTip>
                    </wpfPdfPanel:WpfPdfPanel.AnnotationToolTip>
                </wpfPdfPanel:WpfPdfPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="8 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             ToolTip="Search"
                             Width="240"
                             VerticalContentAlignment="Center" />

                    <Button Command="{Binding PreviousSearchResultCommand}" ToolTip="Previous Result" Cursor="Hand" Margin="4 0 0 0">
                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding NextSearchResultCommand}" ToolTip="Next Result" Cursor="Hand" Margin="4 0 0 0">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" VerticalAlignment="Center" />
                    </Button>

                    <TextBlock VerticalAlignment="Center" Margin="4 0 0 0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource SearchStatusConverter}">
                                <Binding Path="SearchResults" ElementName="pdfPanel" />
                                <Binding Path="CurrentSearchResult" />
                                <Binding Path="SearchResults.Count" ElementName="pdfPanel" />
                                <Binding Path="IsTextExtracted" ElementName="pdfPanel" />
                                <Binding Path="SearchQuery" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Content="Match case" IsChecked="{Binding SearchMatchCase}" VerticalAlignment="Center" Margin="4 0 0 0" />
                    <CheckBox Content="Whole word" IsChecked="{Binding SearchWholeWord}" VerticalAlignment="Center" Margin="4 0 0 0" />
                    <CheckBox Content="Match diacritics" IsChecked="{Binding SearchMatchDiacritics}" VerticalAlignment="Center" Margin="4 0 0 0" />
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"  />
        <DataGrid x:Name="LogDataGrid" Grid.Row="3" ItemsSource="{Binding LogMessages}" AutoGenerateColumns="False" IsReadOnly="True" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding DateTime, StringFormat=G}" Width="120" />
                <DataGridTextColumn Header="Level" Binding="{Binding LogLevel}" Width="80" />
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="150" />
                <DataGridTextColumn Header="Message" Binding="{Binding FormattedMessage}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
