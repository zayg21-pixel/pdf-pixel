<views:DemoWindow x:Class="PdfPixel.Demo.Wpf.Views.ConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:PdfPixel.Demo.Wpf.Views"
                 Width="440"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="16 8 16 16">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="MessageTextBlock"
                           Margin="10 0 0 0"
                           MaxWidth="360"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBox x:Name="DetailsTextBox"
                     Margin="0 12 0 0"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap"
                     MaxHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
                <Button Content="Cancel" MinWidth="88" IsCancel="True" Margin="0 0 8 0" />
                <Button x:Name="ConfirmButton" MinWidth="88" IsDefault="True" Click="ConfirmButton_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</views:DemoWindow>
