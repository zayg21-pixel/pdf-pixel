<views:DemoWindow x:Class="PdfPixel.Demo.Wpf.Views.PasswordPromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:PdfPixel.Demo.Wpf.Views"
                 Title="Password Required"
                 Width="400"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar Title="Password Required" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="16 8 16 16">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="LockClosed24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="This document is password protected. Enter the password to open it."
                           Margin="10 0 0 0"
                           MaxWidth="320"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="ErrorTextBlock"
                       Margin="34 8 0 0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <PasswordBox x:Name="PasswordBox" Margin="0 12 0 0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
                <Button Content="Cancel" MinWidth="88" IsCancel="True" Margin="0 0 8 0" />
                <Button Content="OK" MinWidth="88" IsDefault="True" Click="OkButton_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</views:DemoWindow>
