<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A native C# PDF rendering library for .NET, built around SkiaSharp, with no dependency on external PDF frameworks.</Description>
    <PackageTags>pdf;rendering;skiasharp;raster</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NOTICE.txt" Pack="true" PackagePath="notices\PdfPixel.txt" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PdfPixel.Benchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PdfPixel.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPixel.Color\PdfPixel.Color.csproj" />
    <ProjectReference Include="..\PdfPixel.Jpg\PdfPixel.Jpg.csproj" />
    <ProjectReference Include="..\PdfPixel.Jpx\PdfPixel.Jpx.csproj" />
    <ProjectReference Include="..\PdfPixel.Ccitt\PdfPixel.Ccitt.csproj" />
    <ProjectReference Include="..\PdfPixel.Jbig2\PdfPixel.Jbig2.csproj" />
    <ProjectReference Include="..\PdfPixel.PostScript\PdfPixel.PostScript.csproj" />
    <ProjectReference Include="..\PdfPixel.Fonts\PdfPixel.Fonts.csproj" />
  </ItemGroup>

</Project>
