<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PdfPixel.Demo.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BackgroundColor">#21232B</Color>
            <Color x:Key="ToolbarColor">#2B2D36</Color>
            <Color x:Key="ForegroundColor">#E6E6EA</Color>
            <Color x:Key="AccentColor">#4C8DFF</Color>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource ForegroundColor}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="MinimumWidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource ForegroundColor}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
