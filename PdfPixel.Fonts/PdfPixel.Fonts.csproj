<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Font parsing and glyph outline extraction for .NET: CFF, Type 1, TrueType and OpenType (SFNT), plus the URW Core 35 fonts used as Standard 14 substitutes. A standalone managed implementation with no rendering dependencies, used by PdfPixel for its font handling.</Description>
    <PackageTags>fonts;opentype;truetype;sfnt;cff;type1;glyph</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PdfPixel.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.bin" />
    <EmbeddedResource Include="Resources\Standard14Fonts\*.otf" />
    <None Include="NOTICE.txt" Pack="true" PackagePath="notices\PdfPixel.Fonts.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPixel.PostScript\PdfPixel.PostScript.csproj" />
  </ItemGroup>

</Project>
