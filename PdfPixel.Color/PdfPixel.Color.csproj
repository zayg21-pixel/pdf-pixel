<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ICC color management for .NET: ICC v2 and v4 profile parsing, tone reproduction curves, CLUT pipelines and CMYK conversion. A standalone managed implementation with no rendering dependencies, used by PdfPixel for its color spaces.</Description>
    <PackageTags>icc;color;color-management;cmyk;profile</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PdfPixel.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Profiles\CompactCmyk.icc" />
    <None Include="NOTICE.txt" Pack="true" PackagePath="notices\PdfPixel.Color.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>

</Project>
